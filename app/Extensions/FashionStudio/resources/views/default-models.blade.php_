            opacity: 0.3;
            cursor: grabbing !important;
        }
        
        .model-card.drag-over {
            border: 2px solid #10b981;
            transform: scale(1.02);
            transition: all 0.2s ease;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
        }
        
        .preview-item.dragging {
            opacity: 0.3;
            cursor: grabbing !important;
        }
        
        .preview-item.drag-over {
            border: 2px solid #10b981;
            transform: scale(1.02);
            transition: all 0.2s ease;
            background-color: rgba(16, 185, 129, 0.1);
        }
        
        .preview-item {
            transition: all 0.2s ease;
            cursor: grab;
        }
        
        .preview-item:active {
            cursor: grabbing;
        }
        
        .model-card {
            cursor: grab;
            transition: all 0.2s ease;
        }
        
        .model-card:active {
            cursor: grabbing;
        }
        
        .saving-indicator {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #10b981;
